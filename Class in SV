class packet;
  int id;
  bit[31:0]data;
  function new(int id = 0, bit[31:0]data = 32'h0);
    this.id = id;
    this.data = data;
  endfunction
  function void display(string name)
    $display("[%0s]ID : %0d | Data : 0*%0h",name,id,data);
  endfunction
endclass



